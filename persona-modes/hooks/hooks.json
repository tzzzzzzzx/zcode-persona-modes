{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/persona.ps1",
              "hook",
              "sessionstart"
            ],
            "timeoutMs": 10000,
            "statusMessage": "persona-modes: injecting active mode"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/persona.ps1",
              "hook",
              "prompt"
            ],
            "timeoutMs": 10000,
            "statusMessage": "persona-modes: mode reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|Task",
        "hooks": [
          {
            "type": "process",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/persona.ps1",
              "hook",
              "pretool"
            ],
            "timeoutMs": 8000,
            "statusMessage": "persona-modes: transition flavor"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/persona.ps1",
              "hook",
              "toolfail"
            ],
            "timeoutMs": 8000,
            "statusMessage": "persona-modes: dryness reminder"
          }
        ]
      }
    ]
  }
}
